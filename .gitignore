# ===================================
# .gitignore（Next.js）
# ===================================

# 依存パッケージ
node_modules/
/.pnp
.pnp.js

# ビルド成果物
/.next/
/out/
/build

# 環境変数（絶対にコミットしないこと）
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# デバッグログ
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# エディター
.vscode/
.idea/
*.swp
